<?xml version="1.0" encoding="utf-8"?>
<!--
  DAC's Admin — Receipt Share.

  Exists for exactly one reason: Chrome on MIUI/HyperOS will not pass a shared
  file to a web app's share target (confirmed 2026-09-23 — it POSTs an empty
  75-byte multipart, and Google's own squoosh.app fails the same way on these
  phones). A real Android app receives the file directly from the share sheet,
  so that broken hop never happens.

  The app then hands the photo to the EXISTING share-capture.html wizard in a
  WebView. All the tagging, validation and Supabase writes stay in the web app,
  which remains the single source of truth.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ReceiptShare">

        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">

            <!-- Normal launcher entry, so the app can be opened on its own. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- One receipt shared from Gallery, Photos, Messenger, Files, … -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Several receipts at once. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
