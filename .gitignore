# ── Ignore everything by default ──────────────────────────
*

# ── Allow folders ──────────────────────────────────────────
!*/

# ── Web project files to include ───────────────────────────
!*.html
!*.css
!*.js
!*.json
!*.md
!*.rules
!*.sql
!*.ts
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp
!*.ico
!*.mp4
!*.webm
!*.ttf
!*.woff
!*.woff2
!*.yml
!*.yaml
!.gitignore
!.gitattributes

# ── Exclude generated/build folders ────────────────────────
node_modules/
build/
.gradle/
gradle/
app/

# ── Exclude generated files ─────────────────────────────────
# package.json is TRACKED on purpose: it carries the disabled-build guard
# (npm run build must fail — see src/README.md) and the `npm test` script.
sw.js
package-lock.json
*.apk
*.aab
*.idsig
*.keystore
*.txt
gradlew
gradlew.bat
